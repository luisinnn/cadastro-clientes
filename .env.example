# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Dashboard > Project Settings > API Keys / Data API).
# NEXT_PUBLIC_ = o valor vai para o navegador. Isso é OK para estas duas:
# a chave "publishable" (ou a antiga "anon") é pública; quem protege os dados é o RLS.
# NUNCA coloque aqui a chave "secret" / "service_role".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço oficial do site, sem "/" no final. Vai no link do e-mail de confirmação.
# Local: http://localhost:3000   |   Vercel: https://seu-app.vercel.app
NEXT_PUBLIC_SITE_URL=
